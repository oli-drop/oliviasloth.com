---
import SocialLinks from "./SocialLinks.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";

const path = Astro.url.pathname;
const isDanish = Astro.currentLocale === "da" || path === "/da" || path.startsWith("/da/");
const prefix = isDanish ? "/da" : "";
const nav = isDanish
	? { stories: "Historier", hiking: "Vandring", talks: "Foredrag", about: "Om mig" }
	: { stories: "Stories", hiking: "Hiking", talks: "Talks", about: "About" };
const localizedHref = (href: string) => `${prefix}${href}`;
const isActive = (href: string) => path === localizedHref(href) || path.startsWith(`${localizedHref(href)}/`);
---

<header class="site-header">
	<a class="site-name" href={prefix || "/"}>OLIVIA FJORD SLOTH</a>

	<nav aria-label={isDanish ? "Hovednavigation" : "Main navigation"}>
		<a class:list={{ active: isActive("/stories") }} href={localizedHref("/stories")}>{nav.stories}</a>
		<a class:list={{ active: isActive("/hiking") }} href={localizedHref("/hiking")}>{nav.hiking}</a>
		<a class:list={{ active: isActive("/talks") }} href={localizedHref("/talks")}>{nav.talks}</a>
		<a class:list={{ active: isActive("/about") }} href={localizedHref("/about")}>{nav.about}</a>
	</nav>

	<SocialLinks />
	<LanguageSwitcher />
</header>

<style>
	.site-header {
		display: flex;
		align-items: center;
		padding: 30px 48px;
		font-family: Arial, sans-serif;
	}

	.site-name {
		flex: 0 0 auto;
		color: inherit;
		font-size: 22px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-decoration: none;
		white-space: nowrap;
	}

	nav {
		display: flex;
		gap: 30px;
		margin-left: auto;
	}

	nav a {
		color: inherit;
		font-size: 15px;
		text-decoration: none;
	}

	nav a.active {
		border-bottom: 1px solid currentColor;
	}

	@media (max-width: 800px) {
		.site-header {
			display: grid;
			grid-template-columns: 1fr auto auto;
			grid-template-areas:
				"name name name"
				"nav social language";
			row-gap: 18px;
			padding: 24px 20px;
		}

		.site-name {
			grid-area: name;
			font-size: 17px;
		}

		nav {
			grid-area: nav;
			gap: clamp(12px, 4vw, 20px);
			margin-left: 0;
		}

		nav a {
			font-size: 13px;
		}

		.site-header :global(.social-links) {
			grid-area: social;
		}

		.site-header :global(.language-switcher) {
			grid-area: language;
		}
	}
</style>
