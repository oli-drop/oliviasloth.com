---
interface Props {
	eyebrow: string;
	title: string;
	text: string;
	backHref: string;
	backLabel: string;
}

const { eyebrow, title, text, backHref, backLabel } = Astro.props;
---

<main class="coming-soon">
	<p class="eyebrow">{eyebrow}</p>
	<h1>{title}</h1>
	<p class="message">{text}</p>
	<a href={backHref}>← {backLabel}</a>
</main>

<style>
	.coming-soon {
		max-width: 1200px;
		min-height: 65vh;
		margin: 0 auto;
		padding: 120px 48px 150px;
	}

	.eyebrow {
		margin: 0 0 20px;
		font-family: Arial, sans-serif;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.18em;
	}

	h1 {
		max-width: 900px;
		margin: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(64px, 9vw, 128px);
		font-weight: 400;
		line-height: 0.92;
		letter-spacing: -0.045em;
	}

	.message {
		max-width: 560px;
		margin: 40px 0 34px;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 22px;
		line-height: 1.5;
	}

	a {
		display: inline-block;
		color: inherit;
		font-family: Arial, sans-serif;
		font-size: 13px;
		font-weight: 700;
		text-decoration: none;
		border-bottom: 1px solid currentColor;
		padding-bottom: 3px;
	}

	@media (max-width: 800px) {
		.coming-soon {
			min-height: 60vh;
			padding: 80px 24px 110px;
		}

		h1 {
			font-size: 60px;
		}

		.message {
			font-size: 19px;
		}
	}
</style>
