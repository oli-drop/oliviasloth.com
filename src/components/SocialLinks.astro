---
interface Props {
	light?: boolean;
	hero?: boolean;
}

const { light = false, hero = false } = Astro.props;
---

<div class:list={["social-links", { light, "hero-links": hero }]} aria-label="Social media">
	<a href="https://www.instagram.com/oliviafjord/?hl=da" target="_blank" rel="noopener noreferrer" aria-label="Olivia on Instagram">
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<rect x="3" y="3" width="18" height="18" rx="5"></rect>
			<circle cx="12" cy="12" r="4"></circle>
			<circle class="icon-dot" cx="17.5" cy="6.5" r="1"></circle>
		</svg>
	</a>

	<a href="https://www.facebook.com/olivia.fjordsloth/" target="_blank" rel="noopener noreferrer" aria-label="Olivia on Facebook">
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<path d="M14 8h3V4.3c-.5-.1-2.1-.3-4-.3-3.9 0-6.5 2.4-6.5 6.8V14H3v4h3.5v6h4.2v-6h3.5l.6-4h-4.1v-2.8C10.7 9.8 11.1 8 14 8Z"></path>
		</svg>
	</a>

	<a href="https://www.linkedin.com/in/olivia-fjord-sloth/" target="_blank" rel="noopener noreferrer" aria-label="Olivia on LinkedIn">
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<path d="M5.1 7.8H1.5V22h3.6V7.8ZM3.3 2A2.2 2.2 0 1 0 3.3 6.4 2.2 2.2 0 0 0 3.3 2ZM22.5 13.8c0-4.3-2.3-6.3-5.4-6.3-2.5 0-3.6 1.4-4.2 2.3v-2H9.3V22h3.6v-7c0-1.9.4-3.7 2.7-3.7 2.3 0 2.3 2.1 2.3 3.8V22h3.6v-8.2Z"></path>
		</svg>
	</a>
</div>

<style>
	.social-links {
		display: flex;
		flex: 0 0 auto;
		gap: 13px;
		margin-left: 30px;
		color: #171717;
	}

	.social-links.light {
		color: white;
	}

	.social-links.hero-links {
		position: absolute;
		top: 32px;
		right: 48px;
		z-index: 6;
		margin-left: 0;
	}

	a {
		display: grid;
		width: 24px;
		height: 24px;
		place-items: center;
		color: inherit;
		transition: opacity 150ms ease, transform 150ms ease;
	}

	a:hover,
	a:focus-visible {
		opacity: 0.55;
		transform: translateY(-1px);
	}

	svg {
		width: 18px;
		height: 18px;
		fill: currentColor;
	}

	a:first-child svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
	}

	.icon-dot {
		fill: currentColor;
		stroke: none;
	}

	@media (max-width: 800px) {
		.social-links {
			gap: 7px;
			margin-left: 10px;
		}

		.social-links.hero-links {
			top: 25px;
			right: 20px;
		}

		a {
			width: 20px;
			height: 20px;
		}

		svg {
			width: 15px;
			height: 15px;
		}
	}
</style>
