---
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import ComingSoon from "../../components/ComingSoon.astro";
const isDanish = Astro.currentLocale === "da";
---

<html lang={isDanish ? "da" : "en"}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" sizes="256x256" href="/tent-favicon-2026.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=8" />
		<title>The Big Why — Olivia Fjord Sloth</title>
		<meta name="description" content="The Big Why, a story from Olivia Fjord Sloth’s journey through Syria, is coming soon." />
	</head>
	<body>
		<SiteHeader />
		<ComingSoon
			eyebrow={isDanish ? "SYRIEN · OKTOBER 2025" : "SYRIA · OCTOBER 2025"}
			title={isDanish ? "Kommer snart." : "Coming soon."}
			text={isDanish ? "Jeg er stadig ved at skrive historien fra min første rejse gennem Syrien — til fods, gennem bjerge, huler og spørgsmål, der blev hos mig." : "I’m still writing this story from my first journey through Syria — on foot, through mountains, caves and questions that stayed with me."}
			backHref={isDanish ? "/da/stories" : "/stories"}
			backLabel={isDanish ? "Tilbage til historier" : "Back to stories"}
		/>
		<SiteFooter />
	</body>
</html>

<style>
	:global(*) { box-sizing: border-box; }
	:global(html), :global(body) { margin: 0; padding: 0; background: #f4f1ea; color: #171717; }
</style>
