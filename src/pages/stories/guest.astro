---
import SocialLinks from "../../components/SocialLinks.astro";
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<title>What do your parents think? — Olivia Fjord Sloth</title>
	</head>

	<body>
		<header>
			<a class="name" href="/">OLIVIA FJORD SLOTH</a>

			<nav>
				<a href="/stories">Stories</a>
				<a href="/talks">Talks</a>
				<a href="/about">About</a>
			</nav>
			<SocialLinks />
		</header>

		<main>
			<section class="story-header">
				<p class="category">SYRIA</p>

				<h1>What do your parents think?</h1>

				<p class="subtitle">
					<!-- Put your subtitle here -->
				</p>
			</section>

			<section class="hero">
				<img
					src="/parents.jpg"
					alt="Syria"
				/>
			</section>

			<article>
				<p class="lead">
					Put the opening paragraph of your story here.
				</p>

				<p>
					Continue your story here.
				</p>

				<p>
					And your next paragraph here.
				</p>

				<p>
					You can add as many paragraphs as you need.
				</p>
			</article>

			<div class="back">
				<a href="/stories">← Back to stories</a>
			</div>
		</main>
	</body>
</html>


<style>
	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		padding: 0;
		background: #f4f1ea;
		color: #171717;
	}

	body {
		font-family: Arial, sans-serif;
	}

	header {
		width: 100%;
		padding: 30px 48px;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	.name {
		font-size: 22px;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	nav {
		display: flex;
		gap: 32px;
	}

	nav a {
		font-size: 15px;
	}

	.story-header {
		max-width: 1050px;
		margin: 110px auto 80px;
		padding: 0 48px;
	}

	.category {
		margin: 0 0 25px;
		font-size: 12px;
		letter-spacing: 0.18em;
	}

	h1 {
		margin: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(58px, 8vw, 115px);
		font-weight: 400;
		line-height: 0.95;
		letter-spacing: -0.035em;
	}

	.subtitle {
		max-width: 750px;
		margin: 35px 0 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(23px, 2.5vw, 32px);
		line-height: 1.4;
		color: #666;
	}

	.hero {
		width: 100%;
	}

	.hero img {
		display: block;
		width: 100%;
		max-height: 800px;
		object-fit: cover;
	}

	article {
		max-width: 700px;
		margin: 90px auto 0;
		padding: 0 30px;

		font-family: Georgia, "Times New Roman", serif;
		font-size: 21px;
		line-height: 1.75;
	}

	article p {
		margin: 0 0 34px;
	}

	.lead {
		font-size: 27px;
		line-height: 1.5;
	}

	.back {
		max-width: 700px;
		margin: 90px auto 120px;
		padding: 35px 30px 0;
		border-top: 1px solid #bbb;
		font-size: 14px;
	}

	@media (max-width: 700px) {
		header {
			padding: 24px 20px;
		}

		.name {
			font-size: 17px;
		}

		nav {
			gap: 14px;
		}

		nav a {
			font-size: 13px;
		}

		.story-header {
			margin: 65px auto 55px;
			padding: 0 24px;
		}

		h1 {
			font-size: 58px;
		}

		.subtitle {
			font-size: 25px;
		}

		article {
			margin-top: 60px;
			padding: 0 24px;
			font-size: 19px;
		}

		.lead {
			font-size: 23px;
		}

		.back {
			margin-top: 70px;
			padding-left: 24px;
			padding-right: 24px;
		}
	}
</style>
