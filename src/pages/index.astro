---
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Olivia Fjord Sloth</title>
	</head>

	<body>

		<!-- HERO -->

		<section class="hero">

			<a class="video-panel" href="/stories">
				<video autoplay muted loop playsinline preload="metadata">
					<source src="/hidden3.MP4" type="video/mp4" />
				</video>
				<span>STORIES</span>
			</a>

			<a class="video-panel" href="/talks">
				<video autoplay muted loop playsinline preload="metadata">
					<source src="/drone.MP4" type="video/mp4" />
				</video>
				<span>TALKS</span>
			</a>

			<a class="video-panel" href="/about">
				<video autoplay muted loop playsinline preload="metadata">
					<source src="/me.MP4" type="video/mp4" />
				</video>
				<span>ABOUT</span>
			</a>

			<a class="name" href="/">OLIVIA FJORD SLOTH</a>

		</section>


		<!-- INTRO -->

		<section class="intro">

			<div class="intro-inner">

				<p class="eyebrow">
					STORIES OFF THE MAIN ROAD
				</p>

				<h2>
					Away from the main road,
					literally and otherwise.
				</h2>

				<p class="intro-text">
					Stories from mountains, long walks and time spent with
					people in places we mostly hear about when something goes wrong.
				</p>

				<a class="intro-link" href="/stories">
					Read my stories →
				</a>

			</div>

		</section>


		<!-- LATEST STORY -->

		<section class="latest-section">

			<div class="latest-story">

				<div class="latest-image">
					<img
						src="/stories/hama2.jpg"
						alt="Olivia in the mountains at sunset"
						loading="lazy"
					/>
				</div>

				<div class="latest-content">

					<p class="latest-label">
						LATEST STORY
					</p>

					<h2>
						What do your parents think?
					</h2>

					<p class="latest-subtitle">
						About adventure, family and the parts of ourselves
						we’re expected to outgrow.
					</p>

					<a href="/stories/what-do-your-parents-think">
						Read story →
					</a>

				</div>

			</div>

		</section>


		<!-- HIKING -->

		<section class="hiking-section">

			<div class="hiking-image">
				<img
					src="/hiking/vanding.jpg"
					alt="Hiking in the mountains"
					loading="lazy"
				/>
			</div>

			<div class="hiking-content">

				<p class="hiking-label">
					HIKING
				</p>

				<h2>
					Notes from the trail.
				</h2>

				<p>
					Routes I’ve walked, food I take with me and things
					I wish I had known before I started.
				</p>

				<a href="/hiking">
					Explore hiking →
				</a>

			</div>

		</section>

	</body>
</html>


<style>

	/* GENERAL */

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		padding: 0;
	}

	body {
		background: #f4f1e9;
		color: #111;
	}

	a {
		text-decoration: none;
	}


	/* HERO */

	.hero {
		position: relative;
		width: 100%;
		height: 100vh;

		display: grid;
		grid-template-columns: repeat(3, 1fr);

		overflow: hidden;
		background: #111;
	}

	.video-panel {
		position: relative;
		height: 100vh;

		overflow: hidden;

		display: flex;
		align-items: center;
		justify-content: center;

		text-decoration: none;
	}

	.video-panel video {
		position: absolute;
		inset: 0;

		width: 100%;
		height: 100%;

		object-fit: cover;
		object-position: center;
	}

	.video-panel span {
		position: relative;
		z-index: 2;

		color: white;

		font-family: Arial, sans-serif;
		font-size: clamp(24px, 2.5vw, 42px);
		font-weight: 700;
		letter-spacing: 0.08em;

		text-shadow: 0 2px 15px rgba(0, 0, 0, 0.4);
	}

	.name {
		position: absolute;
		top: 32px;
		left: 48px;
		z-index: 5;

		color: white;

		font-family: Arial, sans-serif;
		font-size: 24px;
		font-weight: 700;
		letter-spacing: 0.08em;
	}


	/* INTRO */

	.intro {
		background: #f4f1e9;
		padding: 120px 48px;
	}

	.intro-inner {
		max-width: 1050px;
		margin: 0 auto;
	}

	.eyebrow {
		margin: 0 0 28px;

		font-family: Arial, sans-serif;
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 0.16em;

		color: #111;
	}

	.intro h2 {
		max-width: 900px;
		margin: 0;

		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(40px, 5.5vw, 76px);
		font-weight: 400;
		line-height: 1.05;
		letter-spacing: -0.025em;

		color: #111;
	}

	.intro-text {
		max-width: 620px;
		margin: 48px 0 28px;

		font-family: Arial, sans-serif;
		font-size: 19px;
		line-height: 1.65;

		color: #111;
	}

	.intro-link {
		display: inline-block;

		color: #111;

		font-family: Arial, sans-serif;
		font-size: 16px;
		font-weight: 700;

		border-bottom: 1px solid #111;
		padding-bottom: 4px;
	}


	/* LATEST STORY */

	.latest-section {
		background: #f4f1e9;
		padding: 40px 48px 140px;
	}

	.latest-story {
		max-width: 1300px;
		margin: 0 auto;

		display: grid;
		grid-template-columns: 1.25fr 0.75fr;
		gap: 80px;
		align-items: center;
	}

	.latest-image img {
		display: block;
		width: 100%;

		aspect-ratio: 16 / 10;
		object-fit: cover;
	}

	.latest-content {
		max-width: 520px;
	}

	.latest-label {
		margin: 0 0 20px;

		font-family: Arial, sans-serif;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.18em;

		color: #111;
	}

	.latest-content h2 {
		margin: 0 0 28px;

		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(44px, 5vw, 72px);
		font-weight: 400;
		line-height: 1;
		letter-spacing: -0.03em;

		color: #111;
	}

	.latest-subtitle {
		margin: 0 0 30px;

		font-family: Georgia, "Times New Roman", serif;
		font-size: 21px;
		line-height: 1.5;

		color: #555;
	}

	.latest-content a {
		display: inline-block;

		color: #111;

		font-family: Arial, sans-serif;
		font-size: 14px;
		font-weight: 700;

		border-bottom: 1px solid #111;
		padding-bottom: 4px;
	}


	/* HIKING */

	.hiking-section {
		background: #ebe6dc;
		padding: 120px 48px 150px;
	}

	.hiking-image {
		max-width: 950px;
		margin: 0 auto;
	}

	.hiking-image img {
		display: block;
		width: 100%;
		height: 480px;
		object-fit: cover;
		object-position: center 60%;
	}

	.hiking-content {
		max-width: 950px;
		margin: 70px auto 0;
	}

	.hiking-label {
		margin: 0 0 20px;

		font-family: Arial, sans-serif;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.18em;

		color: #111;
	}

	.hiking-content h2 {
		max-width: 900px;
		margin: 0 0 30px;

		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(52px, 6vw, 86px);
		font-weight: 400;
		line-height: 1;
		letter-spacing: -0.03em;

		color: #111;
	}

	.hiking-content p {
		max-width: 620px;
		margin: 0 0 30px;

		font-family: Georgia, "Times New Roman", serif;
		font-size: 20px;
		line-height: 1.55;

		color: #555;
	}

	.hiking-content a {
		display: inline-block;

		color: #111;

		font-family: Arial, sans-serif;
		font-size: 14px;
		font-weight: 700;

		border-bottom: 1px solid #111;
		padding-bottom: 4px;
	}


	/* MOBILE */

	@media (max-width: 700px) {

		.hero {
			height: auto;
			grid-template-columns: 1fr;
		}

		.video-panel {
			height: 40vh;
			min-height: 280px;
		}

		.video-panel video {
			width: 100%;
			height: 100%;

			object-fit: cover;
			object-position: center;
		}

		.video-panel span {
			font-size: 30px;
			letter-spacing: 0.08em;
		}

		.name {
			position: fixed;

			top: 20px;
			left: 20px;

			font-size: 18px;
			z-index: 10;
		}


		/* INTRO MOBILE */

		.intro {
			padding: 70px 24px;
		}

		.eyebrow {
			font-size: 11px;
			margin-bottom: 20px;
		}

		.intro h2 {
			font-size: 42px;
			line-height: 1.05;
		}

		.intro-text {
			margin-top: 32px;

			font-size: 17px;
			line-height: 1.6;
		}

		.intro-link {
			font-size: 15px;
		}


		/* LATEST STORY MOBILE */

		.latest-section {
			padding: 20px 24px 90px;
		}

		.latest-story {
			grid-template-columns: 1fr;
			gap: 32px;
		}

		.latest-image img {
			aspect-ratio: 4 / 3;
		}

		.latest-content h2 {
			font-size: 44px;
		}

		.latest-subtitle {
			font-size: 18px;
			line-height: 1.5;
		}


		/* HIKING MOBILE */

		.hiking-section {
			padding: 70px 24px 100px;
		}

		.hiking-image img {
			height: auto;
			aspect-ratio: 4 / 3;
			object-fit: cover;
		}

		.hiking-content {
			margin-top: 40px;
		}

		.hiking-content h2 {
			font-size: 44px;
		}

		.hiking-content p {
			font-size: 18px;
			line-height: 1.5;
		}
	}

</style>