<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Olivia Sloth</title>
	</head>

	<body>

		<!-- HERO -->

		<section class="hero">

			<a class="video-panel" href="/stories">
				<video autoplay muted loop playsinline>
					<source src="/hidden3.MP4" type="video/mp4" />
				</video>
				<span>STORIES</span>
			</a>

			<a class="video-panel" href="/talks">
				<video autoplay muted loop playsinline>
					<source src="/drone.MP4" type="video/mp4" />
				</video>
				<span>TALKS</span>
			</a>

			<a class="video-panel" href="/about">
				<video autoplay muted loop playsinline>
					<source src="/me.MP4" type="video/mp4" />
				</video>
				<span>ABOUT</span>
			</a>

			<a class="name" href="/">OLIVIA SLOTH</a>

		</section>

		<!-- INTRO -->
		<section class="intro">
			<div class="intro-inner">

				<p class="eyebrow">
					STORIES FROM THE ROAD
				</p>

				<h2>
					I travel to places that are often reduced to headlines —
					and stay long enough to find the stories underneath.
				</h2>

				<p class="intro-text">
					I write about people, places and the questions that follow me home.
					About hospitality, conflict, curiosity and what it means to be a guest.
				</p>

				<a class="intro-link" href="/stories">
					Read my stories →
				</a>

			</div>
		</section>

	</body>
</html>


<style>

	/* GENERAL */

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		padding: 0;
	}


	/* HERO */
	.hero {
		position: relative;
		width: 100%;
		height: 100vh;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		overflow: hidden;
		background: #111;
	}

	.video-panel {
		position: relative;
		height: 100vh;
		overflow: hidden;
		display: flex;
		align-items: center;
		justify-content: center;
		text-decoration: none;
	}

	.video-panel video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.video-panel span {
		position: relative;
		z-index: 2;
		color: white;
		font-family: Arial, sans-serif;
		font-size: clamp(24px, 2.5vw, 42px);
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	.name {
		position: absolute;
		top: 32px;
		left: 48px;
		z-index: 5;
		color: white;
		font-family: Arial, sans-serif;
		font-size: 24px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-decoration: none;
	}

	header {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		padding: 32px 48px;

		display: flex;
		justify-content: space-between;
		align-items: center;

		z-index: 2;

		font-family: Arial, sans-serif;
	}

	a {
		text-decoration: none;
	}

	.name {
		color: white;
		font-size: 24px;
		font-weight: 700;
		letter-spacing: 0.08em;
	}
	.video-nav {
	position: absolute;
	inset: 0;
	z-index: 3;

	display: grid;
	grid-template-columns: repeat(3, 1fr);

	pointer-events: none;
	}

	.video-nav a {
		display: flex;
		align-items: center;
		justify-content: center;

		color: white;
		text-decoration: none;

		font-family: Arial, sans-serif;
		font-size: clamp(22px, 2.5vw, 42px);
		font-weight: 700;
		letter-spacing: 0.08em;

		text-shadow: 0 2px 15px rgba(0, 0, 0, 0.45);

		pointer-events: auto;
	}



	/* INTRO */

	.intro {
		background: #f4f1e9;
		padding: 120px 48px;
	}

	.intro-inner {
		max-width: 1050px;
		margin: 0 auto;
	}

	.eyebrow {
		margin: 0 0 28px;

		font-family: Arial, sans-serif;
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 0.16em;

		color: #111;
	}

	.intro h2 {
		max-width: 900px;
		margin: 0;

		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(40px, 5.5vw, 76px);
		font-weight: 400;
		line-height: 1.05;
		letter-spacing: -0.025em;

		color: #111;
	}

	.intro-text {
		max-width: 620px;
		margin: 48px 0 28px;

		font-family: Arial, sans-serif;
		font-size: 19px;
		line-height: 1.65;

		color: #111;
	}

	.intro-link {
		color: #111;

		font-family: Arial, sans-serif;
		font-size: 16px;
		font-weight: 700;

		border-bottom: 1px solid #111;
		padding-bottom: 4px;
	}


	/* MOBILE */

	@media (max-width: 700px) {

		header {
			padding: 24px;
		}

		.name {
			font-size: 18px;
		}

		nav {
			gap: 14px;
		}

		nav a {
			font-size: 14px;
		}

		.intro {
			padding: 80px 24px;
		}

		.intro h2 {
			font-size: 40px;
		}

		.intro-text {
			margin-top: 36px;
			font-size: 17px;
		}
	}

</style>