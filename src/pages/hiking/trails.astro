---
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
const isDanish = Astro.currentLocale === "da";
---

<html lang={isDanish ? "da" : "en"}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" sizes="256x256" href="/tent-favicon-2026.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=8" />
		<title>{isDanish ? "Ruter jeg har vandret — Olivia Fjord Sloth" : "Trails I've Walked — Olivia Fjord Sloth"}</title>
		<meta name="description" content={isDanish ? "Langdistanceruter vandret af Olivia Fjord Sloth med rutedetaljer, GPX-filer og praktiske noter." : "Long-distance trails walked by Olivia Fjord Sloth, with route details, GPX files and practical notes."} />
	</head>

	<body>

		<SiteHeader />


		<main>

			<!-- INTRO -->

			<section class="hero">

				<p class="eyebrow">{isDanish ? "RUTER JEG HAR VANDRET" : "ROUTES I’VE WALKED"}</p>

				<h1>{isDanish ? "Stier jeg har vandret." : "Trails I’ve walked."}</h1>

				<p class="intro">
					{isDanish ? "Ruter jeg har vandret med GPX-filer, praktiske noter og ting, jeg ville ønske, jeg havde vidst, før jeg tog af sted." : "Routes I’ve walked, with GPX files, practical notes and things I wish I had known before I went."}
				</p>

			</section>


			<!-- TRAILS -->

			<section class="trails-grid">

				<a class="trail-card" href={isDanish ? "/da/hiking/trails/pamir-trail" : "/hiking/trails/pamir-trail"}>

					<div class="trail-image">
						<img
							src="/hiking/bus_tji.webp"
							alt="Travelling to the Pamir Trail in Tajikistan"
							loading="lazy"
							decoding="async"
						/>
					</div>

					<div class="trail-info">

						<p class="trail-country">
							{isDanish ? "TADSJIKISTAN" : "TAJIKISTAN"}
						</p>

						<h2>Pamir Trail</h2>

						<p class="trail-details">
							{isDanish ? "158,5 km · Fannbjergene · højeste pas 4.750 m" : "158.5 km · Fann Mountains · highest pass 4,750 m"}
						</p>
						<p class="trail-description">
							{isDanish ? "Den smukkeste vandring, jeg nogensinde har gennemført — og en del hårdere, end jeg forventede." : "The most beautiful hike I have ever done, and quite a bit harder than I expected."}
						</p>

						<span>{isDanish ? "Se ruten →" : "View trail →"}</span>

					</div>

				</a>

			</section>

		</main>

		<SiteFooter />
	</body>
</html>


<style>

	/* GENERAL */

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		padding: 0;
		background: #f4f1ea;
		color: #171717;
	}

	body {
		font-family: Arial, sans-serif;
	}

	a {
		color: inherit;
		text-decoration: none;
	}


	/* HEADER */

	header {
		padding: 30px 48px;

		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.name {
		font-size: 22px;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	nav {
		display: flex;
		gap: 28px;
	}

	nav a {
		font-size: 15px;
	}

	nav .active {
		border-bottom: 1px solid #171717;
	}


	/* HERO */

	.hero {
		max-width: 1200px;
		margin: 100px auto 110px;
		padding: 0 48px;
	}

	.eyebrow {
		margin: 0 0 20px;

		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.18em;
	}

	.hero h1 {
		max-width: 1000px;
		margin: 0;

		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(64px, 8vw, 115px);
		font-weight: 400;
		line-height: 0.94;
		letter-spacing: -0.04em;
	}

	.intro {
		max-width: 700px;
		margin: 40px 0 0;

		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(22px, 2.4vw, 31px);
		line-height: 1.45;

		color: #555;
	}


	/* TRAILS */

	.trails-grid {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 48px 150px;

		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 70px 40px;
	}

	.trail-card {
		display: block;
	}

	.trail-image {
		overflow: hidden;
	}

	.trail-image img {
		display: block;
		width: 100%;

		aspect-ratio: 4 / 3;
		object-fit: cover;

		transition: transform 0.3s ease;
	}

	.trail-card:hover .trail-image img {
		transform: scale(1.015);
	}

	.trail-info {
		padding-top: 22px;
	}

	.trail-country {
		margin: 0 0 13px;

		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.17em;
	}

	.trail-info h2 {
		margin: 0 0 15px;

		font-family: Georgia, "Times New Roman", serif;
		font-size: 42px;
		font-weight: 400;
		line-height: 1.05;
	}

	.trail-details {
		margin: 0 0 18px;

		font-family: Arial, sans-serif;
		font-size: 13px;
		line-height: 1.5;

		color: #555;
	}

	.trail-description {
		max-width: 500px;
		margin: 0 0 22px;

		font-family: Georgia, "Times New Roman", serif;
		font-size: 18px;
		line-height: 1.55;

		color: #555;
	}

	.trail-info span {
		display: inline-block;

		font-size: 13px;
		font-weight: 700;

		border-bottom: 1px solid #171717;
		padding-bottom: 4px;
	}


	/* MOBILE */

	@media (max-width: 700px) {

		header {
			padding: 24px 20px;
		}

		.name {
			font-size: 17px;
		}

		nav {
			gap: 12px;
		}

		nav a {
			font-size: 12px;
		}


		.hero {
			margin: 60px auto 75px;
			padding: 0 24px;
		}

		.hero h1 {
			font-size: 58px;
		}

		.intro {
			font-size: 21px;
		}


		.trails-grid {
			padding: 0 24px 100px;

			grid-template-columns: 1fr;
			gap: 70px;
		}

		.trail-info h2 {
			font-size: 36px;
		}

		.trail-description {
			font-size: 17px;
		}

	}

</style>
