---
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import ComingSoon from "../../components/ComingSoon.astro";
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" sizes="256x256" href="/favicon-original-tent-close.png?v=7" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=7" />
		<title>Trail Food — Olivia Fjord Sloth</title>
		<meta name="description" content="Olivia Fjord Sloth’s notes about food for long-distance hiking are coming soon." />
	</head>
	<body>
		<SiteHeader />
		<ComingSoon
			eyebrow="TRAIL FOOD"
			title="Coming soon."
			text="I’m still writing my notes about what I eat on long hikes, what works for me and what definitely doesn’t."
			backHref="/hiking"
			backLabel="Back to hiking"
		/>
		<SiteFooter />
	</body>
</html>

<style>
	:global(*) { box-sizing: border-box; }
	:global(html), :global(body) { margin: 0; padding: 0; background: #f4f1ea; color: #171717; }
</style>
