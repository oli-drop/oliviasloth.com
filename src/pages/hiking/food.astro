---
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import ComingSoon from "../../components/ComingSoon.astro";
const isDanish = Astro.currentLocale === "da";
---

<html lang={isDanish ? "da" : "en"}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" sizes="256x256" href="/favicon-original-tent-close.png?v=8" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=8" />
		<title>Trail Food — Olivia Fjord Sloth</title>
		<meta name="description" content="Olivia Fjord Sloth’s notes about food for long-distance hiking are coming soon." />
	</head>
	<body>
		<SiteHeader />
		<ComingSoon
			eyebrow={isDanish ? "MAD PÅ TUREN" : "TRAIL FOOD"}
			title={isDanish ? "Kommer snart." : "Coming soon."}
			text={isDanish ? "Jeg er stadig ved at skrive mine noter om, hvad jeg spiser på lange vandringer, hvad der fungerer for mig, og hvad der bestemt ikke gør." : "I’m still writing my notes about what I eat on long hikes, what works for me and what definitely doesn’t."}
			backHref={isDanish ? "/da/hiking" : "/hiking"}
			backLabel={isDanish ? "Tilbage til vandring" : "Back to hiking"}
		/>
		<SiteFooter />
	</body>
</html>

<style>
	:global(*) { box-sizing: border-box; }
	:global(html), :global(body) { margin: 0; padding: 0; background: #f4f1ea; color: #171717; }
</style>
