---
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import ComingSoon from "../../components/ComingSoon.astro";
const isDanish = Astro.currentLocale === "da";
---

<html lang={isDanish ? "da" : "en"}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" sizes="256x256" href="/tent-favicon-2026.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=8" />
		<title>Planning & Gear — Olivia Fjord Sloth</title>
		<meta name="description" content="Olivia Fjord Sloth’s practical notes about planning and hiking gear are coming soon." />
	</head>
	<body>
		<SiteHeader />
		<ComingSoon
			eyebrow={isDanish ? "PLANLÆGNING & UDSTYR" : "PLANNING & GEAR"}
			title={isDanish ? "Kommer snart." : "Coming soon."}
			text={isDanish ? "Jeg samler mine noter om planlægning, erfaringer med udstyr og de fejl, jeg ville ønske, nogen havde fortalt mig om, før jeg begyndte." : "I’m gathering the planning notes, gear lessons and mistakes I wish someone had told me about before I started."}
			backHref={isDanish ? "/da/hiking" : "/hiking"}
			backLabel={isDanish ? "Tilbage til vandring" : "Back to hiking"}
		/>
		<SiteFooter />
	</body>
</html>

<style>
	:global(*) { box-sizing: border-box; }
	:global(html), :global(body) { margin: 0; padding: 0; background: #f4f1ea; color: #171717; }
</style>
