---
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import ComingSoon from "../../components/ComingSoon.astro";
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon.png?v=2" />
		<title>Planning & Gear — Olivia Fjord Sloth</title>
		<meta name="description" content="Olivia Fjord Sloth’s practical notes about planning and hiking gear are coming soon." />
	</head>
	<body>
		<SiteHeader />
		<ComingSoon
			eyebrow="PLANNING & GEAR"
			title="Coming soon."
			text="I’m gathering the planning notes, gear lessons and mistakes I wish someone had told me about before I started."
			backHref="/hiking"
			backLabel="Back to hiking"
		/>
		<SiteFooter />
	</body>
</html>

<style>
	:global(*) { box-sizing: border-box; }
	:global(html), :global(body) { margin: 0; padding: 0; background: #f4f1ea; color: #171717; }
</style>
