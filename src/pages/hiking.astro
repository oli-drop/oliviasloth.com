---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

const isDanish = Astro.currentLocale === "da";
const localize = (path: string) => isDanish ? `/da${path}` : path;
---

<html lang={isDanish ? "da" : "en"}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" sizes="256x256" href="/favicon-original-tent-close.png?v=8" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=8" />
		<title>{isDanish ? "Vandring — Olivia Fjord Sloth" : "Hiking — Olivia Fjord Sloth"}</title>
		<meta name="description" content={isDanish ? "Vandrenoter, ruter, planlægning og praktiske erfaringer fra Olivia Fjord Sloths ture." : "Trail notes, routes, planning and practical lessons from Olivia Fjord Sloth’s hikes."} />
	</head>

	<body>
		<SiteHeader />

		<main>

			<section class="hero">
				<p class="eyebrow">{isDanish ? "NOTER FRA STIEN" : "NOTES FROM THE TRAIL"}</p>

				<h1>{isDanish ? "Noter fra stien." : "Notes from the trail."}</h1>

				<p class="intro">
					{isDanish ? "Ruter jeg har vandret, GPX-filer, mad, planlægning og det, jeg har lært ved faktisk at være derude." : "Routes I’ve walked, GPX files, food, planning and the things I’ve learned by actually being out there."}
				</p>
			</section>


			<section class="guide-grid">

				<a class="guide-card" href={localize("/hiking/trails")}>
					<img src="/hiking/kurdistan.webp" alt="Mountain hiking trail" loading="lazy" decoding="async" />

					<div class="guide-content">
						<p class="label">{isDanish ? "RUTER" : "ROUTES"}</p>
						<h2>{isDanish ? "Stier jeg har vandret" : "Trails I’ve walked"}</h2>
						<p>
							{isDanish ? "Ruter, GPX-filer og mine egne noter fra vandringer i blandt andet Kirgisistan, Tadsjikistan og Iran." : "Routes, GPX files and my own notes from hikes in places like Kyrgyzstan, Tajikistan and Iran."}
						</p>
						<span>{isDanish ? "Udforsk ruter →" : "Explore trails →"}</span>
					</div>
				</a>


				<a class="guide-card" href={localize("/hiking/food")}>
					<div class="card-image">
						<img src="/hiking/food.jpg" alt="Food for hiking" loading="lazy" decoding="async" />
						<span class="coming-soon-label">{isDanish ? "KOMMER SNART" : "COMING SOON"}</span>
					</div>

					<div class="guide-content">
						<p class="label">{isDanish ? "MAD PÅ TUREN" : "TRAIL FOOD"}</p>
						<h2>{isDanish ? "Hvad jeg spiser på lange vandringer" : "What I eat on long hikes"}</h2>
						<p>
							{isDanish ? "Tørret mad, hvad der fungerer for mig, og hvad jeg faktisk bærer med, når jeg er ude i flere dage." : "Dehydrated meals, what works for me and what I actually carry when I’m out for several days."}
						</p>
						<span>{isDanish ? "Mad på turen →" : "Trail food →"}</span>
					</div>
				</a>


				<a class="guide-card" href={localize("/hiking/planning")}>
					<div class="card-image">
						<img src="/hiking/planing.jpg" alt="Map and hiking planning" loading="lazy" decoding="async" />
						<span class="coming-soon-label">{isDanish ? "KOMMER SNART" : "COMING SOON"}</span>
					</div>

					<div class="guide-content">
                        <p class="label">{isDanish ? "PLANLÆGNING & UDSTYR" : "PLANNING & GEAR"}</p>

                        <h2>{isDanish ? "Ting jeg ville ønske, jeg vidste" : "Things I wish I knew"}</h2>

                        <p>
                            {isDanish ? "Udstyr, pakning, planlægning og nogle af de ting, jeg lærte på den langsomme måde." : "Gear, packing, planning and some of the things I learned the slow way."}
                        </p>

                        <span>{isDanish ? "Læs mine noter →" : "Read my notes →"}</span>
					</div>
				</a>

			</section>

		</main>
		<SiteFooter />
	</body>
</html>


<style>

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		padding: 0;
		background: #f4f1ea;
		color: #171717;
	}

	body {
		font-family: Arial, sans-serif;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	header {
		padding: 30px 48px;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.name {
		font-size: 22px;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	nav {
		display: flex;
		gap: 28px;
	}

	nav a {
		font-size: 15px;
	}

	nav .active {
		border-bottom: 1px solid #171717;
	}

	.hero {
		max-width: 1200px;
		margin: 100px auto 100px;
		padding: 0 48px;
	}

	.eyebrow,
	.label {
		margin: 0 0 20px;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.18em;
	}

	h1 {
		margin: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(70px, 9vw, 130px);
		font-weight: 400;
		line-height: 0.92;
		letter-spacing: -0.04em;
	}

	.intro {
		max-width: 720px;
		margin: 40px 0 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(23px, 2.6vw, 34px);
		line-height: 1.4;
		color: #555;
	}

	.guide-grid {
		max-width: 1400px;
		margin: 0 auto;
		padding: 0 48px 130px;

		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 35px;
	}

	.card-image {
		position: relative;
	}

	.coming-soon-label {
		position: absolute;
		top: 40px;
		left: -3px;
		right: -3px;
		padding: 12px 16px;
		background: rgba(255, 255, 255, 0.92);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
		color: #171717;
		text-align: center;
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.18em;
	}

	.guide-card img {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
	}

	.guide-content {
		padding-top: 22px;
	}

	.guide-content h2 {
		margin: 0 0 14px;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 34px;
		font-weight: 400;
		line-height: 1.05;
	}

	.guide-content > p:not(.label) {
		margin: 0 0 18px;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 17px;
		line-height: 1.55;
		color: #555;
	}

	.guide-content span {
		display: inline-block;
		font-size: 13px;
		font-weight: 700;
		border-bottom: 1px solid #171717;
		padding-bottom: 3px;
	}

	.guide-card:hover img {
		opacity: 0.93;
	}

	@media (max-width: 800px) {

		header {
			padding: 24px 20px;
		}

		.name {
			font-size: 17px;
		}

		nav {
			gap: 12px;
		}

		nav a {
			font-size: 12px;
		}

		.hero {
			margin: 60px auto 70px;
			padding: 0 24px;
		}

		h1 {
			font-size: 62px;
		}

		.intro {
			font-size: 22px;
		}

		.guide-grid {
			grid-template-columns: 1fr;
			padding: 0 24px 90px;
			gap: 70px;
		}

		.guide-card img {
			aspect-ratio: 4 / 3;
		}
	}

</style>
