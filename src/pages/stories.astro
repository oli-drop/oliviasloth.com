---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" sizes="256x256" href="/favicon-original-tent-close.png?v=7" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=7" />
		<title>Stories — Olivia Fjord Sloth</title>
		<meta name="description" content="Personal stories from mountains, long walks and journeys beyond the familiar." />
	</head>

	<body>
		<SiteHeader />

		<main>

			<!-- PAGE INTRO -->

			<section class="page-intro">
				<p class="eyebrow">NOTES FROM ALONG THE WAY</p>

				<h1>Stories</h1>

				<p class="intro-text">
					Stories about people, places and questions I don’t have easy answers to.
				</p>
			</section>


			<!-- LATEST STORY -->

			<section class="featured-story">
				<a href="/stories/what-do-your-parents-think">

					<div class="featured-image">
						<img
							src="/stories/hama2.webp"
							alt="Olivia in the mountains at sunset"
							decoding="async"
						/>
					</div>

					<div class="featured-text">
						<p class="story-meta">
							LATEST STORY · PERSONAL ESSAY
						</p>

						<h2>
							What do your parents think?
						</h2>

						<p class="description">
							About adventure, family and the parts of ourselves
							we’re expected to outgrow.
						</p>

						<span class="read-link">
							Read story →
						</span>
					</div>

				</a>
			</section>


			<!-- OLDER STORIES -->

			<section class="story-grid">

				<!-- I DON'T HAVE A PLAN -->

				<article class="story-card">
					<a href="/stories/i-dont-have-a-plan">

						<img
							src="/stories/profil.webp"
							alt="Olivia hiking"
							loading="lazy"
							decoding="async"
						/>

						<p class="story-meta">
							PERSONAL ESSAY · 2026
						</p>

						<h3>
							I don’t have a plan
						</h3>

						<p class="description">
							In a few weeks, I’m leaving my job and flying to Syria
							on a one-way ticket.
						</p>

						<span class="read-link">
							Read story →
						</span>

					</a>
				</article>


				<!-- THE BIG WHY -->

				<article class="story-card">
					<a href="/stories/the-big-why">

						<div class="card-image">
							<img
								src="/stories/hama.jpg"
								alt="Ancient ruins in Syria"
								loading="lazy"
								decoding="async"
							/>
							<span class="coming-soon-label">COMING SOON</span>
						</div>

						<p class="story-meta">
							SYRIA · OCTOBER 2025
						</p>

						<h3>
							The big why
						</h3>

						<p class="description">
							My first journey through Syria, on foot, through mountains,
							caves and a country I knew mostly from the headlines.
						</p>

						<span class="read-link">
							Read story →
						</span>

					</a>
				</article>


				<!-- DAMAVAND -->

				<article class="story-card">
					<a href="/stories/in-the-mountains-we-are-all-free">

						<img
							src="/stories/damavand.webp"
							alt="On Mount Damavand in Iran"
							loading="lazy"
							decoding="async"
						/>

						<p class="story-meta">
							IRAN · 2022
						</p>

						<h3>
							"In the mountains we are all free"
						</h3>

						<p class="description">
							I went to Iran to climb its highest mountain alone.
							What stayed with me were the people I met along the way.
						</p>

						<span class="read-link">
							Read story →
						</span>

					</a>
				</article>

			</section>



		</main>
		<SiteFooter />
	</body>
</html>


<style>

	/* GENERAL */

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		padding: 0;
		background: #f4f1ea;
		color: #171717;
	}

	body {
		font-family: Arial, sans-serif;
	}

	a {
		color: inherit;
		text-decoration: none;
	}


	/* HEADER */

	header {
		padding: 30px 48px;

		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.name {
		font-size: 22px;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	nav {
		display: flex;
		gap: 32px;
	}

	nav a {
		font-size: 15px;
	}

	nav .active {
		border-bottom: 1px solid #171717;
	}


	/* PAGE INTRO */

	.page-intro {
		max-width: 1200px;
		margin: 80px auto 90px;
		padding: 0 48px;
	}

	.eyebrow {
		margin: 0 0 20px;

		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.18em;
	}

	h1 {
		margin: 0;

		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(72px, 9vw, 130px);
		font-weight: 400;
		line-height: 0.9;
		letter-spacing: -0.045em;
	}

	.intro-text {
		max-width: 520px;
		margin: 35px 0 0;

		font-family: Georgia, "Times New Roman", serif;
		font-size: 25px;
		line-height: 1.4;
	}


	/* FEATURED STORY */

	.featured-story {
		max-width: 1200px;
		margin: 0 auto 120px;
		padding: 0 48px;
	}

	.featured-story > a {
		display: grid;
		grid-template-columns: 1.35fr 0.85fr;
		gap: 65px;
		align-items: center;
	}

	.featured-image img {
		width: 100%;
		display: block;

		aspect-ratio: 16 / 10;
		object-fit: cover;
	}

	.featured-text {
		max-width: 500px;
	}

	.story-meta {
		margin: 0 0 15px;

		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.16em;
	}

	.featured-text h2 {
		margin: 0 0 24px;

		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(44px, 5vw, 72px);
		font-weight: 400;
		line-height: 1;
		letter-spacing: -0.025em;
	}

	.description {
		margin: 0 0 24px;

		font-family: Georgia, "Times New Roman", serif;
		font-size: 18px;
		line-height: 1.5;
		color: #555;
	}

	.read-link {
		display: inline-block;

		font-size: 13px;
		font-weight: 700;

		padding-bottom: 3px;
		border-bottom: 1px solid #171717;
	}


	/* STORY GRID */

	.story-grid {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 48px 130px;

		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 45px;
	}

	.story-card img {
		width: 100%;
		display: block;

		aspect-ratio: 4 / 3;
		object-fit: cover;

		margin-bottom: 18px;
	}

	.card-image {
		position: relative;
		margin-bottom: 18px;
	}

	.card-image img {
		margin-bottom: 0;
	}

	.coming-soon-label {
		position: absolute;
		top: 40px;
		left: -3px;
		right: -3px;
		padding: 12px 16px;
		background: rgba(255, 255, 255, 0.92);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
		color: #171717;
		text-align: center;
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.18em;
	}

	.story-card h3 {
		margin: 0 0 12px;

		font-family: Georgia, "Times New Roman", serif;
		font-size: 32px;
		font-weight: 400;
		line-height: 1.1;
		letter-spacing: -0.015em;
	}

	.story-card .description {
		max-width: 480px;
		font-size: 15px;
		margin-bottom: 18px;
	}


	/* LITTLE HOVER EFFECT */

	.featured-story a:hover img,
	.story-card a:hover img {
		opacity: 0.93;
	}

	.featured-story a:hover .read-link,
	.story-card a:hover .read-link {
		opacity: 0.6;
	}


	/* MOBILE */

	@media (max-width: 800px) {

		header {
			padding: 24px 20px;
		}

		.name {
			font-size: 17px;
		}

		nav {
			gap: 14px;
		}

		nav a {
			font-size: 13px;
		}


		.page-intro {
			margin: 55px auto 65px;
			padding: 0 24px;
		}

		h1 {
			font-size: 68px;
		}

		.intro-text {
			font-size: 21px;
		}


		.featured-story {
			margin-bottom: 90px;
			padding: 0 24px;
		}

		.featured-story > a {
			grid-template-columns: 1fr;
			gap: 32px;
		}

		.featured-text h2 {
			font-size: 46px;
		}

		.featured-text .description {
			font-size: 18px;
		}


		.story-grid {
			padding: 0 24px 90px;
			grid-template-columns: 1fr;
			gap: 70px;
		}

		.story-card h3 {
			font-size: 30px;
		}
	}

</style>
